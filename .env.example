# Telegram Bot
TELEGRAM_TOKEN=put-your-telegram-bot-token-here

LLM_PROVIDER=yandex

# YandexGPT
YANDEX_API_KEY=
# or YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
YANDEX_API_URL=https://rest-assistant.api.cloud.yandex.net/v1

# Admins (comma-separated Telegram user IDs)
ADMIN_IDS=

# Optional
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=12
MAX_ALTERNATIVES=3
STYLE_MODE=auto  # auto | strict | conversational | formal
ALWAYS_STRICT=0  # 1 to force strict replacements globally
